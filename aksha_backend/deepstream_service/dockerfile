# DeepStream 6.3 base — includes:
#   - CUDA 11.8 (matches RTX 2070 driver requirements)
#   - NVDEC hardware decoder (nvv4l2decoder GStreamer plugin)
#   - GStreamer 1.x with all NVIDIA plugins
#   - Python 3 GStreamer bindings (gi)
#   - pyds (DeepStream Python bindings, available if needed for future nvinfer upgrade)
#
# Why not cuda:11.8 + manual GStreamer?
#   nvv4l2decoder is only distributed via the DeepStream package;
#   the DeepStream base image is the simplest way to get it on a dGPU.
FROM nvcr.io/nvidia/deepstream:6.3-gc-triton-devel

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Kolkata
# Pin timezone early so any package that reads /etc/localtime gets the right offset
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install Python GStreamer bindings and OpenCV system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-gi \
    python3-gi-cairo \
    gir1.2-gst-plugins-base-1.0 \
    gir1.2-gstreamer-1.0 \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Prepend CUDA libs so OpenCV and ORT runtime CUDA calls resolve correctly
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

WORKDIR /code

COPY requirements.txt ./
# onnxruntime-gpu must be installed first from the CUDA 12 private feed before
# the rest of requirements.txt — the public PyPI wheel targets CUDA 11 and will
# silently install the wrong runtime if pulled in as a transitive dependency.
RUN pip3 install --no-cache-dir \
    onnxruntime-gpu==1.17.1 \
    --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/ && \
    pip3 install --no-cache-dir -r requirements.txt

# Copy entire app/ directory — includes main.py, object_detection.py,
# coco.names, yolov10.onnx, LOADING_IMG.png, RTSP_ISSUE_IMG.png
# Code resolves model paths via os.path.dirname(__file__) = /code/app/
COPY app/ ./app/

# Runs the single-camera inference service; camera identity passed via env vars
ENTRYPOINT ["python3", "app/main.py"]

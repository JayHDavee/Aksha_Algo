# deepstream_nvinfer — DeepStream 8.0 + NvInfer dynamic pipeline
# Base: NVIDIA DeepStream 8.0 with Triton + CUDA 12.x + GStreamer + nvinfer
# Target GPU: RTX 3050 (Ampere sm86)
# Adds: pyds 1.2.2 Python bindings (Python 3.12), CUDA-enabled OpenCV 4.10 (sm86), libturbojpeg
#
# DS 8.0 is the latest version with pre-built pyds wheels.
# DS 9.0 deprecated pyds — would require rewrite to PyServiceMaker.

FROM nvcr.io/nvidia/deepstream:8.0-triton-multiarch

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Kolkata
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-gi \
    python3-gi-cairo \
    gir1.2-gst-plugins-base-1.0 \
    gir1.2-gstreamer-1.0 \
    libglib2.0-0 \
    libgl1 \
    cmake \
    git \
    libpng-dev \
    libjpeg-turbo8-dev \
    libtiff-dev \
    libeigen3-dev \
    libturbojpeg-dev \
    && rm -rf /var/lib/apt/lists/*

ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# pyds 1.2.2 — DeepStream 8.0 Python bindings (NvDsInferTensorMeta, pyds.gst_buffer_get_nvds_batch_meta, etc.)
# Built for Python 3.12 (cp312). Cannot import at build time — libcuda.so.1 only available at runtime.
RUN pip3 install --no-cache-dir \
    https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.2.2/pyds-1.2.2-cp312-cp312-linux_x86_64.whl

# Build OpenCV 4.10.0 with CUDA for RTX 3050 (Ampere sm86).
# CUDA_ARCH_BIN=8.6 only: no PTX fallback needed for a fixed GPU container.
# Disabled modules: calib3d, features2d, flann, ml, objdetect, photo, stitching, video, gapi
#   — not used by this service, cuts build time and image size.
RUN PYSITE=$(python3 -c "import site; print(site.getsitepackages()[0])") \
    && git clone --depth=1 --branch 4.10.0 https://github.com/opencv/opencv.git /tmp/opencv \
    && git clone --depth=1 --branch 4.10.0 https://github.com/opencv/opencv_contrib.git /tmp/opencv_contrib \
    && cmake -B /tmp/opencv_build /tmp/opencv \
        -DCMAKE_BUILD_TYPE=Release \
        -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
        -DWITH_CUDA=ON \
        -DCUDA_ARCH_BIN="8.6" \
        -DCUDA_ARCH_PTX="" \
        -DWITH_CUDNN=OFF \
        -DBUILD_opencv_python3=ON \
        -DPYTHON3_EXECUTABLE=$(which python3) \
        -DPYTHON3_PACKAGES_PATH="$PYSITE" \
        -DBUILD_TESTS=OFF \
        -DBUILD_PERF_TESTS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_opencv_apps=OFF \
        -DBUILD_opencv_calib3d=OFF \
        -DBUILD_opencv_features2d=OFF \
        -DBUILD_opencv_flann=OFF \
        -DBUILD_opencv_ml=OFF \
        -DBUILD_opencv_objdetect=OFF \
        -DBUILD_opencv_photo=OFF \
        -DBUILD_opencv_stitching=OFF \
        -DBUILD_opencv_video=OFF \
        -DBUILD_opencv_gapi=OFF \
    && cmake --build /tmp/opencv_build -j$(nproc) \
    && cmake --install /tmp/opencv_build \
    && python3 -c "import cv2; print('cv2 OK:', cv2.__version__, '| CUDA:', cv2.cuda.getCudaEnabledDeviceCount())" \
    && rm -rf /tmp/opencv /tmp/opencv_contrib /tmp/opencv_build

WORKDIR /code

COPY requirements.txt ./
RUN pip3 install --no-cache-dir -r requirements.txt

COPY app/ ./app/
COPY patch_models.py ./

# Patch TopK axis=-1 → axis=1 so TRT accepts the ONNX model.
RUN python3 patch_models.py && rm patch_models.py

EXPOSE 8080
ENTRYPOINT ["python3", "app/main.py"]

# DeepStream 7.1 optimized batch inference service — RTX 3050 (Ampere sm86)
# Base image: NVIDIA DeepStream 7.1 + CUDA 12.6 + TRT 10.x + GStreamer + nvinfer
# Adds: pyds 1.2.0 Python bindings, CUDA-enabled OpenCV 4.10 (sm86), libturbojpeg
FROM nvcr.io/nvidia/deepstream:7.1-triton-multiarch

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Kolkata
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-gi \
    python3-gi-cairo \
    gir1.2-gst-plugins-base-1.0 \
    gir1.2-gstreamer-1.0 \
    libglib2.0-0 \
    libgl1 \
    cmake \
    git \
    libpng-dev \
    libjpeg-turbo8-dev \
    libtiff-dev \
    libeigen3-dev \
    libturbojpeg-dev \
    && rm -rf /var/lib/apt/lists/*

ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# pyds 1.2.0 — DeepStream 7.1 Python bindings
RUN pip3 install --no-cache-dir \
    https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.2.0/pyds-1.2.0-py3-none-linux_x86_64.whl

# Build OpenCV 4.10.0 with CUDA for RTX 3050 (Ampere sm86).
# CUDA_ARCH_BIN=8.6 only — no PTX fallback needed for a fixed-GPU container.
RUN PYSITE=$(python3 -c "import site; print(site.getsitepackages()[0])") \
    && git clone --depth=1 --branch 4.10.0 https://github.com/opencv/opencv.git /tmp/opencv \
    && git clone --depth=1 --branch 4.10.0 https://github.com/opencv/opencv_contrib.git /tmp/opencv_contrib \
    && cmake -B /tmp/opencv_build /tmp/opencv \
        -DCMAKE_BUILD_TYPE=Release \
        -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
        -DWITH_CUDA=ON \
        -DCUDA_ARCH_BIN="8.6" \
        -DCUDA_ARCH_PTX="" \
        -DWITH_CUDNN=OFF \
        -DBUILD_opencv_python3=ON \
        -DPYTHON3_EXECUTABLE=$(which python3) \
        -DPYTHON3_PACKAGES_PATH="$PYSITE" \
        -DBUILD_TESTS=OFF \
        -DBUILD_PERF_TESTS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_opencv_apps=OFF \
        -DBUILD_opencv_calib3d=OFF \
        -DBUILD_opencv_features2d=OFF \
        -DBUILD_opencv_flann=OFF \
        -DBUILD_opencv_ml=OFF \
        -DBUILD_opencv_objdetect=OFF \
        -DBUILD_opencv_photo=OFF \
        -DBUILD_opencv_stitching=OFF \
        -DBUILD_opencv_video=OFF \
        -DBUILD_opencv_gapi=OFF \
    && cmake --build /tmp/opencv_build -j$(nproc) \
    && cmake --install /tmp/opencv_build \
    && python3 -c "import cv2; print('cv2 OK:', cv2.__version__, '| CUDA:', cv2.cuda.getCudaEnabledDeviceCount())" \
    && rm -rf /tmp/opencv /tmp/opencv_contrib /tmp/opencv_build

WORKDIR /code

COPY requirements_rtx3050.txt ./
RUN pip3 install --no-cache-dir -r requirements_rtx3050.txt

COPY app/ ./app/
COPY patch_models.py ./

RUN python3 patch_models.py && rm patch_models.py

EXPOSE 8080
ENTRYPOINT ["python3", "app/main.py"]

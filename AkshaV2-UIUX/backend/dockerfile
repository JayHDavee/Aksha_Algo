# ---- Stage 1: Base setup ----
FROM node:18-slim AS base
WORKDIR /backend
COPY package*.json tsconfig.json ./

# ---- Stage 2: Install dependencies ----
FROM base AS dependencies
RUN npm install
RUN npm install -g pkg typescript esbuild

# ---- Stage 3: Build with tsc + esbuild ----
FROM dependencies AS build
WORKDIR /backend
COPY . .

# Build: tsc first, then bundle with esbuild
RUN npm run build

# Generate executable from bundled file
ENV PKG_CACHE_PATH=/pkg-cache
RUN --mount=type=cache,target=/pkg-cache \
  pkg --target node18-linux-x64 -o /backend/dist/exe_nodebackend ./dist/bundle.js

# ---- Stage 4: Minimal runtime image ----
FROM ubuntu:20.04 AS release
WORKDIR /backend
ENV NODE_ENV=production
ENV TZ=Asia/Kolkata

# Copy only .env and compiled binary
COPY ./.env /backend/.env
COPY --from=build /backend/dist/exe_nodebackend /backend/

# Run the binary
ENTRYPOINT ["./exe_nodebackend"]
